// PUT /api/cart  { UserId, items: [{ ProductId, ProductName, Price, Quantity, Size, ImageUrl }] }
// Replaces the user's whole cart in one transaction.
app.put("/api/cart", route("CART SYNC", async (req, res) => {

    const userId = toUserId(req.body.UserId);
    const items = Array.isArray(req.body.items) ? req.body.items : null;

    if (!userId || !items) {
        return res.status(400).json({ success: false, message: "UserId and items are required" });
    }

    const conn = await pool.getConnection();

    try {
        await conn.beginTransaction();

        await conn.execute("DELETE FROM Cart WHERE UserId=?", [userId]);

        for (const item of items) {

            const name = String(item.ProductName || "").trim();
            const price = toPrice(item.Price);

            if (!name || price === null) {
                throw new Error("Invalid cart item: " + JSON.stringify(item));
            }

            await conn.execute(
                `INSERT INTO Cart (UserId, ProductId, ProductName, Price, Quantity, Size, ImageUrl)
                 VALUES (?, ?, ?, ?, ?, ?, ?)`,
                [
                    userId,
                    toUserId(item.ProductId),
                    name,
                    price,
                    toQuantity(item.Quantity),
                    item.Size || "N/A",
                    item.ImageUrl || ""
                ]
            );
        }

        await conn.commit();
        console.log(`CART SAVED -> user ${userId}, ${items.length} item(s)`);
        logActivity("CART", { userId, details: `${items.length} item(s)` });
        res.json({ success: true, message: "Cart Saved", count: items.length });

    } catch (err) {
        await conn.rollback().catch(() => {});
        throw err;
    } finally {
        conn.release();
    }
}));

