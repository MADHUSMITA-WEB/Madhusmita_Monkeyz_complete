app.post("/api/login", route("LOGIN", async (req, res) => {

    const username = String(req.body.username || "").trim();
    const password = String(req.body.password || "");

    if (!username || !password) {
        return res.status(400).json({ success: false, message: "Enter username/email and password" });
    }

    const [rows] = await pool.execute(
        "SELECT * FROM signup WHERE name=? OR email=?",
        [username, username.toLowerCase()]
    );

    if (rows.length === 0) {
        console.log("LOGIN FAILED - user not found:", username);
        logActivity("LOGIN_FAILED", { details: "user not found: " + username });
        return res.status(401).json({ success: false, message: "Invalid Login" });
    }

    const user = rows[0];

    if (!(await bcrypt.compare(password, user.password))) {
        console.log("LOGIN FAILED - wrong password:", user.email);
        logActivity("LOGIN_FAILED", { userId: user.id, email: user.email, details: "wrong password" });
        return res.status(401).json({ success: false, message: "Wrong Password" });
    }

    // Login history. If this fails the user can still log in,
    // but the reason is printed in the terminal.
    try {
        await pool.execute(
            "INSERT INTO login (email, UserId, Name) VALUES (?, ?, ?)",
            [user.email, user.id, user.name]
        );
        console.log("LOGIN SAVED -> id:", user.id, "email:", user.email);
        logActivity("LOGIN", { userId: user.id, email: user.email });
    } catch (err) {
        console.error("[LOGIN HISTORY]", err.sqlMessage || err.message);
    }

    res.json({
        success: true,
        message: "Login Successful",
        user: { id: user.id, name: user.name, email: user.email }
    });
}));

