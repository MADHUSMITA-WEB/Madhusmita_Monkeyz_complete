// =========================
// ADMIN LOGIN
// Password comes from ADMIN_PASSWORD in .env.
// After login the browser gets a signed token (valid 12 hours)
// that every admin route checks.
// =========================

const ADMIN_PASSWORD = process.env.ADMIN_PASSWORD || "";
const ADMIN_SECRET = process.env.ADMIN_SECRET || crypto.randomBytes(32).toString("hex");
const ADMIN_TOKEN_HOURS = 12;

if (ADMIN_PASSWORD.length < 8) {
    console.warn("⚠️  ADMIN_PASSWORD missing or shorter than 8 characters in .env – admin login is disabled");
}

function signAdmin(value) {
    return crypto.createHmac("sha256", ADMIN_SECRET).update(String(value)).digest("hex");
}

function safeEqual(a, b) {
    const x = Buffer.from(String(a));
    const y = Buffer.from(String(b));
    return x.length === y.length && crypto.timingSafeEqual(x, y);
}

function makeAdminToken() {
    const expires = Date.now() + ADMIN_TOKEN_HOURS * 60 * 60 * 1000;
    return expires + "." + signAdmin(expires);
}

function isValidAdminToken(token) {
    const [expires, sig] = String(token || "").split(".");
    if (!expires || !sig || Number(expires) < Date.now()) return false;
    return safeEqual(signAdmin(expires), sig);
}

function requireAdmin(req, res, next) {
    const auth = req.headers.authorization || "";
    const token = auth.startsWith("Bearer ") ? auth.slice(7) : "";
    if (!isValidAdminToken(token)) {
        return res.status(401).json({ success: false, message: "Admin login required" });
    }
    next();
}

// Simple brute-force protection: 5 wrong passwords -> blocked for 15 minutes
const adminFailures = new Map();

app.post("/api/admin/login", (req, res) => {
    const ip = req.ip;
    const rec = adminFailures.get(ip) || { count: 0, until: 0 };

    if (rec.until > Date.now()) {
        return res.status(429).json({ success: false, message: "Too many attempts. Try again in 15 minutes." });
    }

    if (ADMIN_PASSWORD.length < 8) {
        return res.status(500).json({ success: false, message: "Admin password not set on server" });
    }

    if (!safeEqual(String(req.body.password || ""), ADMIN_PASSWORD)) {
        rec.count += 1;
        if (rec.count >= 5) { rec.until = Date.now() + 15 * 60 * 1000; rec.count = 0; }
        adminFailures.set(ip, rec);
        logActivity("ADMIN_LOGIN_FAILED", { details: "ip " + ip });
        return res.status(401).json({ success: false, message: "Wrong admin password" });
    }

    adminFailures.delete(ip);
    logActivity("ADMIN_LOGIN", { details: "ip " + ip });
    res.json({ success: true, token: makeAdminToken() });
});

