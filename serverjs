app.get("/api/db-test", route("DB TEST", async (req, res) => {

    const [[db]] = await pool.execute("SELECT DATABASE() AS database_name");
    const counts = {};

    for (const table of ["signup", "login", "Store", "Cart", "Orders", "ActivityLog"]) {
        try {
            const [[row]] = await pool.execute(`SELECT COUNT(*) AS n FROM ${table}`);
            counts[table] = row.n;
        } catch (err) {
            counts[table] = "ERROR: " + (err.sqlMessage || err.message);
        }
    }

    res.json({ ...db, rows: counts });
}));

