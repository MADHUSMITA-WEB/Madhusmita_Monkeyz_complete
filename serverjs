// Wraps async routes so a database error always sends a JSON
// response with the real MySQL message (instead of hanging or sending {}).
function route(label, handler) {
    return async (req, res) => {
        try {
            await handler(req, res);
        } catch (err) {
            console.error(`[${label}]`, err.code || "", err.sqlMessage || err.message);
            logActivity("ERROR", { details: `[${label}] ${err.sqlMessage || err.message}` });
            if (!res.headersSent) {
                res.status(500).json({
                    success: false,
                    message: err.sqlMessage || err.message || "Internal Server Error"
                });
            }
        }
    };
}

// Saves an event in the ActivityLog table, so the same messages shown
// in the terminal can be read later in MySQL (also after hosting).
// Never pass passwords or payment card details here.
function logActivity(action, { userId = null, email = null, details = null } = {}) {
    pool.execute(
        "INSERT INTO ActivityLog (Action, UserId, Email, Details) VALUES (?, ?, ?, ?)",
        [action, userId, email, details ? String(details).slice(0, 1000) : null]
    ).catch(err => console.error("[ACTIVITY LOG]", err.sqlMessage || err.message));
}

function toUserId(value) {
    const id = parseInt(value, 10);
    // MySQL INT max; larger values (e.g. Date.now() ids) are ignored
    return Number.isInteger(id) && id > 0 && id <= 2147483647 ? id : null;
}

function toQuantity(value) {
    const q = parseInt(value, 10);
    return Number.isInteger(q) && q > 0 ? q : 1;
}

function toPrice(value) {
    const p = Number(value);
    return Number.isFinite(p) && p >= 0 ? p : null;
}

async function columnExists(table, column) {
    const [rows] = await pool.execute(
        `SELECT 1 FROM information_schema.COLUMNS
         WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = ? AND COLUMN_NAME = ?`,
        [table, column]
    );
    return rows.length > 0;
}

async function addColumnIfMissing(table, column, definition) {
    if (!(await columnExists(table, column))) {
        await pool.execute(`ALTER TABLE ${table} ADD COLUMN ${column} ${definition}`);
        console.log(`Added column ${table}.${column}`);
    }
}

// =========================
// DATABASE SETUP
// Creates missing tables and adds the UserId column to Cart,
// so each user has their own cart.
// =========================

async function initDatabase() {

    await pool.execute(`
        CREATE TABLE IF NOT EXISTS signup (
            id INT AUTO_INCREMENT PRIMARY KEY,
            name VARCHAR(100) NOT NULL,
            email VARCHAR(150) NOT NULL UNIQUE,
            password VARCHAR(255) NOT NULL
        )
    `);

    await pool.execute(`
        CREATE TABLE IF NOT EXISTS login (
            id INT AUTO_INCREMENT PRIMARY KEY,
            email VARCHAR(150) NOT NULL
        )
    `);
    await addColumnIfMissing("login", "UserId", "INT NULL");
    await addColumnIfMissing("login", "Name", "VARCHAR(100) NULL");
    await addColumnIfMissing("login", "LoginTime", "TIMESTAMP DEFAULT CURRENT_TIMESTAMP");

    await pool.execute(`
        CREATE TABLE IF NOT EXISTS Store (
            StoreId INT AUTO_INCREMENT PRIMARY KEY,
            ProductId INT NULL,
            ProductName VARCHAR(200) NOT NULL,
            Price DECIMAL(10,2) NOT NULL,
            ImageUrl VARCHAR(500) NULL,
            Quantity INT NOT NULL DEFAULT 0,
            Size VARCHAR(20) NULL,
            UserId INT NULL
        )
    `);

    await pool.execute(`
        CREATE TABLE IF NOT EXISTS Cart (
            CartId INT AUTO_INCREMENT PRIMARY KEY,
            ProductName VARCHAR(200) NOT NULL,
            Price DECIMAL(10,2) NOT NULL,
            Quantity INT NOT NULL DEFAULT 1,
            Size VARCHAR(20) NULL,
            ImageUrl VARCHAR(500) NULL
        )
    `);
    await addColumnIfMissing("Cart", "UserId", "INT NULL");
    await addColumnIfMissing("Cart", "ProductId", "INT NULL");
    await addColumnIfMissing("Cart", "ImageUrl", "VARCHAR(500) NULL");

    await pool.execute(`
        CREATE TABLE IF NOT EXISTS Orders (
            OrderId INT AUTO_INCREMENT PRIMARY KEY,
            RazorpayOrderId VARCHAR(64) NOT NULL UNIQUE,
            PaymentId VARCHAR(64) NULL,
            UserId INT NULL,
            Amount DECIMAL(10,2) NOT NULL,
            Currency VARCHAR(5) NOT NULL DEFAULT 'INR',
            Status VARCHAR(20) NOT NULL DEFAULT 'created',
            Items JSON NULL,
            CreatedAt TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            PaidAt TIMESTAMP NULL
        )
    `);

    await pool.execute(`
        CREATE TABLE IF NOT EXISTS ActivityLog (
            LogId INT AUTO_INCREMENT PRIMARY KEY,
            Action VARCHAR(30) NOT NULL,
            UserId INT NULL,
            Email VARCHAR(150) NULL,
            Details VARCHAR(1000) NULL,
            CreatedAt TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    `);

    const [[db]] = await pool.execute("SELECT DATABASE() AS name");
    console.log("Connected to database:", db.name);
}

