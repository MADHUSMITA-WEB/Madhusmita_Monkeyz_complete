// Add a new T-shirt
app.post("/api/admin/products", requireAdmin, uploadImage, route("ADMIN ADD", async (req, res) => {

    const name = String(req.body.ProductName || "").trim();
    const price = toPrice(req.body.Price);
    const stock = Math.max(0, parseInt(req.body.Quantity, 10) || 0);

    if (!name || price === null || price <= 0) {
        if (req.file) deleteUploadedImage("/uploads/" + req.file.filename);
        return res.status(400).json({ success: false, message: "Name and a valid price are required" });
    }
    if (!req.file) {
        return res.status(400).json({ success: false, message: "Please choose a T-shirt photo" });
    }

    const imageUrl = "/uploads/" + req.file.filename;

    const [result] = await pool.execute(
        `INSERT INTO Store (ProductName, Price, ImageUrl, Quantity, Size)
         VALUES (?, ?, ?, ?, ?)`,
        [name, price, imageUrl, stock, cleanSizes(req.body.Size)]
    );
    await pool.execute("UPDATE Store SET ProductId=? WHERE StoreId=?", [result.insertId, result.insertId]);

    console.log("ADMIN ADDED T-SHIRT -> StoreId:", result.insertId, name);
    logActivity("ADMIN_PRODUCT_ADD", { details: `StoreId ${result.insertId}: ${name}` });

    res.json({ success: true, message: "T-shirt added", storeId: result.insertId, imageUrl });
}));

// Edit a T-shirt (photo is optional – keep the old one if none is sent)
app.put("/api/admin/products/:id", requireAdmin, uploadImage, route("ADMIN EDIT", async (req, res) => {

    const id = toUserId(req.params.id);
    const [rows] = await pool.execute("SELECT * FROM Store WHERE StoreId=?", [id]);

    if (!id || rows.length === 0) {
        if (req.file) deleteUploadedImage("/uploads/" + req.file.filename);
        return res.status(404).json({ success: false, message: "T-shirt not found" });
    }

    const old = rows[0];
    const name = String(req.body.ProductName ?? old.ProductName).trim();
    const price = toPrice(req.body.Price ?? old.Price);
    const stock = Math.max(0, parseInt(req.body.Quantity ?? old.Quantity, 10) || 0);

    if (!name || price === null || price <= 0) {
        if (req.file) deleteUploadedImage("/uploads/" + req.file.filename);
        return res.status(400).json({ success: false, message: "Name and a valid price are required" });
    }

    const imageUrl = req.file ? "/uploads/" + req.file.filename : old.ImageUrl;

    await pool.execute(
        "UPDATE Store SET ProductName=?, Price=?, Quantity=?, Size=?, ImageUrl=? WHERE StoreId=?",
        [name, price, stock, cleanSizes(req.body.Size ?? old.Size), imageUrl, id]
    );

    if (req.file && old.ImageUrl !== imageUrl) deleteUploadedImage(old.ImageUrl);

    logActivity("ADMIN_PRODUCT_EDIT", { details: `StoreId ${id}: ${name}` });
    res.json({ success: true, message: "T-shirt updated", imageUrl });
}));

// Delete a T-shirt
app.delete("/api/admin/products/:id", requireAdmin, route("ADMIN DELETE", async (req, res) => {

    const id = toUserId(req.params.id);
    const [rows] = await pool.execute("SELECT * FROM Store WHERE StoreId=?", [id]);

    if (!id || rows.length === 0) {
        return res.status(404).json({ success: false, message: "T-shirt not found" });
